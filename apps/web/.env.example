# Copy to apps/web/.env.local. All three are required in production builds.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Supabase project settings > API (local values are printed by `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# the GitHub App's URL name (github.com/apps/<slug>)
NEXT_PUBLIC_GITHUB_APP_SLUG=prismos-app
