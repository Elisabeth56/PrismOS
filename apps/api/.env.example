# Copy to apps/api/.env. Blank values are required unless marked optional.

# LLM providers: aistudio.google.com/apikey and console.groq.com/keys (both have free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
# optional overrides when free-tier model ids change
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b

# Supabase project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Project settings > Database > Connection string > Session pooler (works from IPv4 hosts like Render)
DATABASE_URL=
# optional: only for projects on the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# optional: raises GitHub's rate limit for public repo reads
GITHUB_TOKEN=

# comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
LOG_LEVEL=INFO
